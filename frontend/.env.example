# Laisser vide en développement (le proxy Vite gère /api -> backend XAMPP).
# En production, renseigner l'URL complète du backend, ex :
# VITE_API_BASE_URL=https://votre-domaine.tn
VITE_API_BASE_URL=

# URL de base pour les fichiers statiques (photos de profil), non couverts par
# le proxy Vite. Par défaut, correspond au chemin XAMPP standard du projet.
VITE_BACKEND_STATIC_URL=http://localhost/pfe-soutenance-manager/backend
